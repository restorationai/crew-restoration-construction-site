---
import { getEntry, getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CtaBanner from "~/components/CtaBanner.astro";
import FAQSection from "~/components/FAQSection.astro";
import HomeFaq from "~/components/HomeFaq.astro";
import { homeFaq } from "~/lib/homeFaq";
import InternalLinks from "~/components/InternalLinks.astro";
import Hero from "~/components/ui/Hero.astro";
import TrustStrip from "~/components/ui/TrustStrip.astro";
import InsuranceBanner from "~/components/ui/InsuranceBanner.astro";
import HomeProof from "~/components/ui/HomeProof.astro";
import HomeAwards from "~/components/ui/HomeAwards.astro";
import AboutSection from "~/components/ui/AboutSection.astro";
import ServicesStrip from "~/components/ui/ServicesStrip.astro";
import VideoEmbed from "~/components/VideoEmbed.astro";
import ProcessSection from "~/components/ui/ProcessSection.astro";
import BeforeAfterSection from "~/components/ui/BeforeAfterSection.astro";
import RecentWork from "~/components/RecentWork.astro";
import ProudlyServing from "~/components/ui/ProudlyServing.astro";
import ReviewsSection from "~/components/ui/ReviewsSection.astro";
import { brand } from "~/lib/brand";
import homepageServices from "~/data/homepage-services.json";
import { workPairs } from "~/data/work";
import { careers } from "~/data/careers";
import { Briefcase, CheckCircle2, Mail } from "@lucide/astro";
import { regionHeadline, regionSentence } from "~/lib/region";

const entry = await getEntry("pages", "home");
if (!entry) throw new Error("Missing content: pages/home.md — has Skill 3 rendered yet?");
const { Content } = await entry.render();
const data = entry.data;
// SERVICE REGION (Santino 2026-11-19): the homepage speaks to the whole
// region. The generated h1/title/meta name the home city, so the tail is
// swapped at render (no-op when serviceRegion is empty or already named).
const homeH1 = regionHeadline(data.h1);
const homeTitle = regionHeadline(data.title);
const homeMeta = regionSentence(data.meta_description);

const heroImage = data.hero || "/images/hero-bg.webp";

// Pull top 6 services by priority for the home page strip
const allServices = await getCollection("services");
// HOMEPAGE = CURATED CORE (Santino 2026-09-30): plan-input "homepage_services"
// mirrored to src/data/homepage-services.json (scripts/site_structure.py).
// GBP-parity and core-floor pages get /services/ + internal links, never
// this strip. An empty list falls back to the old top-6 by priority.
const pinnedServices = homepageServices as string[];
const services = pinnedServices.length
  ? (pinnedServices
      .map((s) => (allServices as CollectionEntry<"services">[]).find((e) => e.data.service_slug === s || e.slug === s))
      .filter(Boolean) as CollectionEntry<"services">[])
  : (allServices as CollectionEntry<"services">[])
      .sort((a, b) => (b.data.priority || 0) - (a.data.priority || 0))
      .slice(0, 6);
// Homepage FAQ (Santino 2026-11-01): money-term questions answered with
// facts on file; the same list is the page's FAQPage JSON-LD.
const faqItems = homeFaq();
---

<BaseLayout
  title={homeTitle}
  meta_description={homeMeta}
  hero_image_url={heroImage}
  schema_stubs={["organization", "website", "local-business", ...(faqItems.length ? ["faq"] : [])]}
  schema_ctx={{ archetype: "home" }}
  faq={faqItems}
>
  {/* Homepage hero background. DEFAULT for new builds: a branded small-fleet
      scene (3-5 matched vehicles in the client's brand-color livery, region-
      matched street, golden hour, calm left third for the headline) generated
      per the client's image-style-guide.md "Homepage hero" spec, uploaded to
      R2 at brand/hero-fleet.webp and referenced via brand.imagesBase — or
      dropped into public/images/hero-bg.webp if R2 isn't provisioned yet. */}
  <Hero title={homeH1} subtitle={homeMeta} backgroundImage={heroImage} leftScrim />

  <TrustStrip />
  <InsuranceBanner />

  {/* Proof section (Santino 2026-10-03): earns "best {trade} company in
      {city}" with the real rating, licenses, certifications and reviews.
      Replaces ReviewsStrip on the homepage (same rating + snippets job). */}
  <HomeProof />

  {/* Awards (Santino 11-01): its own section, strongest first, each linked. */}
  <HomeAwards />

  <AboutSection imageSrc="/images/work/crew-red-shirts-team.webp" imageAlt={`The ${brand.displayName} crew in red CREW shirts in front of a company pickup`}>
    <p>
      {/* Vertical copy — never hardcode a trade phrase here (industry-bleed
          audit 2026-07-31: this paragraph shipped All Pro's plumbing identity
          on four restoration sites). */}
      {brand.homeAboutBlurb}
    </p>
  </AboutSection>

  <!-- Kyle's real YouTube videos (client request 2026-07-28): the current
       @Crew3r channel pieces: brand intro + the since-1974 story. Lite
       embeds: nothing loads from YouTube until clicked. -->
  <section class="bg-dark py-16 md:py-20 border-t border-white/10">
    <div class="container-wide max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8 md:gap-10 items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-white mb-4">Watch CREW in Action</h2>
          <VideoEmbed videoId="Lntfqh3vxPE" title="Meet Crew Restoration & Construction | 50+ Years of Serving Sioux Falls" />
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-white mb-4">Our Story, Since 1974</h2>
          <VideoEmbed videoId="zW5VrLtjlJs" title="Our Story | Restoring Properties. Rebuilding Lives. Since 1974." />
        </div>
      </div>
      {/* The 'crew' YouTube playlist from the old crew3r.com homepage, restored
          at Mohsin's request (email 2026-11-16, for Kyle), with the CREW Bio
          video Mohsin emailed the same day beside it (self-hosted file, loads
          nothing until play is pressed). */}
      <div id="crew-bio" class="mt-10 md:mt-12 grid md:grid-cols-2 gap-8 md:gap-10 items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-white mb-4">CREW Bio</h2>
          <div class="relative w-full overflow-hidden rounded-sm bg-black aspect-video">
            <video class="absolute inset-0 w-full h-full" controls playsinline preload="none"
              poster="/videos/crew-bio-poster.webp" title="CREW Bio | Crew Restoration & Construction">
              <source src="/videos/crew-bio.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-white mb-4">More CREW Videos</h2>
          <VideoEmbed videoId="W-c4EejKufI" playlistId="PLKqC0CIhTfx9THE1FaOKC22ltMD36Vaar" title="CREW Construction & Restoration videos" />
        </div>
      </div>
    </div>
  </section>

  {/* Payment options link from the front of the site (Kyle 2026-11-13). */}
  <section class="bg-dark-900 text-white py-8 border-t border-white/10">
    <div class="container-wide max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tighter text-white !m-0">Payment Options</h2>
        <p class="text-white/85 m-0 mt-1">Six ways to pay, including 9 months same as cash, plus a 5% same day discount and our Price Assurance Guarantee.</p>
      </div>
      <a href="/financing/" class="shrink-0 btn-primary px-6 py-3 font-black uppercase tracking-wider no-underline">See Financing Options</a>
    </div>
  </section>

  {/* Technician Hiring section (Mohsin for CREW, email 2026-11-20: "a
      professional hiring section or advertisement that highlights our
      technician job opportunities ... direct applicants to contact us at
      estimates@crewthatcares.com"). Replaces the Kyle 11-07 careers strip.
      Openings and wording come from src/data/careers.ts (the client's own
      posting); the apply CTA is careers.applyEmail. */}
  <section id="hiring" class="bg-primary-600 text-white py-14 md:py-16">
    <div class="container-wide max-w-6xl mx-auto px-4">
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-3">
          <p class="text-sm font-black uppercase tracking-widest text-white/80 m-0 mb-2">Now Hiring Technicians in {brand.addressCity}</p>
          <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter text-white !m-0">Join the CREW</h2>
          <p class="text-lg text-white/90 mt-4 mb-6">
            We hire for character and teach the trade. No experience needed: every new
            technician gets paid training, paid IICRC certifications and a clear path
            from Apprentice to Specialist to Lead.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={`mailto:${careers.applyEmail}?subject=${encodeURIComponent("Technician job application")}`}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-white text-dark-900 font-black uppercase tracking-wider px-6 py-3 no-underline hover:bg-white/90">
              <Mail size={18} /> Email to Apply
            </a>
            <a href="/careers/" class="inline-flex items-center justify-center rounded-md border border-white/60 text-white font-black uppercase tracking-wider px-6 py-3 no-underline hover:bg-white/10">See Job Details</a>
          </div>
          <p class="text-white/85 text-sm mt-4 mb-0">Email your name, phone number and a little about yourself to <a href={`mailto:${careers.applyEmail}`} class="font-bold text-white">{careers.applyEmail}</a>.</p>
        </div>
        <div class="lg:col-span-2 grid gap-4">
          {careers.openings.map((o) => (
            <div class="rounded-2xl bg-white text-dark-900 p-6 shadow-lg">
              <div class="flex items-center gap-2 mb-1">
                <Briefcase size={20} class="text-primary-600 shrink-0" />
                <h3 class="!m-0 text-lg font-black">{o.title}</h3>
              </div>
              <p class="text-xs font-bold uppercase tracking-wider text-dark/60 m-0 mb-3">{o.location} · {o.type} · {o.level}</p>
              <ul class="list-none pl-0 m-0 space-y-2 text-dark/80">
                {[...o.pay.slice(0, 2), ...o.benefits.slice(0, 2), o.benefits.find((b) => b.startsWith("Paid IICRC")) ?? ""].filter(Boolean).map((x) => (
                  <li class="flex gap-2 m-0"><CheckCircle2 size={18} class="text-primary-600 shrink-0 mt-0.5" /><span>{x}</span></li>
                ))}
              </ul>
              <a href={`/careers/#${o.slug}`} class="inline-block mt-4 font-black text-primary-700 no-underline hover:underline">Full job details</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {services.length > 0 && <ServicesStrip services={services} />}

  <ProcessSection />

  <BeforeAfterSection pairs={workPairs} />

  <RecentWork />

  <ReviewsSection />

  <ProudlyServing />

  <CtaBanner heading="24/7 Emergency Response" subheading="We answer the phone day and night. Insurance billing accepted." />

  <HomeFaq extra={data.faq} />

  <section class="bg-white py-20 border-t border-dark/10">
    <div class="container-wide max-w-6xl mx-auto prose prose-xl prose-invert prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tighter prose-a:text-primary-700 text-dark/70">
      <Content />
    </div>
  </section>

  <InternalLinks paths={data.internal_links} heading="Where to Next" />
</BaseLayout>
